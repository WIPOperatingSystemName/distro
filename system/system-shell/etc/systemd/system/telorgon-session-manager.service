[Unit]
Description=Telorgon authentication and user session manager
Requires=dbus.service systemd-logind.service
After=dbus.service systemd-logind.service systemd-sysusers.service
PartOf=telorgon-shell.service

[Service]
Type=dbus
BusName=org.telorgon.Session1
ExecStart=/usr/bin/telorgon-test-shell --session-manager
Restart=on-failure
RestartSec=2
UMask=0077
LimitCORE=0
TimeoutStopSec=15
