[Unit]
Description=System D-Bus message bus
After=systemd-tmpfiles-setup.service
Requires=dbus.socket
After=dbus.socket

[Service]
Type=exec
ExecStart=/usr/bin/dbus-daemon --system --nofork --nopidfile --systemd-activation --address=systemd:
RuntimeDirectory=dbus
ExecReload=/usr/bin/dbus-send --system --type=method_call --dest=org.freedesktop.DBus / org.freedesktop.DBus.ReloadConfig
OOMScoreAdjust=-900

[Install]
WantedBy=multi-user.target
Alias=dbus-org.freedesktop.DBus.service
