# Runtime logs, captures, and profiling output (source fixtures stay visible).
/*.log
/logs/
/screenshots/
/captures/
/latency-*.jsonl
/trace-*.json
/trace-*.jsonl
/profile-*.json
/profile-*.jsonl
*.profraw
*.profdata
/*.prof
/perf.data
/perf.data.*
/flamegraph*.svg

# Local scratch work and editor/OS temporary files.
/scratch/
/tmp/
/.local/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Loose image/VM outputs; recipes and profiles remain source.
/*.iso
/*.img
/*.qcow2
/*.vmdk
/*.vdi
